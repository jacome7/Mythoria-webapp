{
  "name": "mythoria-webapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "cross-env NODE_OPTIONS=--disable-warning=DEP0040 next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "rimraf .next/types .next/dev/types && node ./node_modules/typescript-native/bin/tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "postinstall": "patch-package",
    "logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/logs.ps1",
    "revenue:sentinel": "tsx scripts/reconcile-stripe-admin-orders.ts",
    "keyinvoice:discover": "tsx scripts/keyinvoice-discover.ts",
    "keyinvoice:smoke": "tsx scripts/keyinvoice-smoke-test.ts",
    "ga4:smoke": "tsx scripts/ga4-delivery-smoke.ts",
    "analytics:reconcile-products": "tsx scripts/reconcile-product-analytics.ts",
    "surveys:validate": "tsx scripts/publish-surveys.ts --validate-only",
    "surveys:publish": "tsx scripts/publish-surveys.ts",
    "surveys:local-test": "tsx scripts/seed-local-survey-test.ts",
    "keyinvoice:retry": "tsx scripts/keyinvoice-retry-fiscal-documents.ts",
    "i18n:prune:pt-PT:common": "tsx scripts/prune-unused-keys.ts pt-PT common.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx -r dotenv/config ./src/db/migrate.ts",
    "db:biographer": "node --import tsx scripts/biographer-migration.ts",
    "db:biographer:rehearse": "node --import tsx scripts/rehearse-biographer-migration.cjs",
    "db:push": "drizzle-kit push",
    "db:reset": "tsx -r dotenv/config ./src/db/reset.ts",
    "db:setup": "npm run db:reset && npm run db:push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx -r dotenv/config ./src/db/seed.ts",
    "db:seo-preflight": "tsx scripts/seo-db-preflight.ts",
    "db:seo-postflight": "tsx scripts/seo-db-preflight.ts --postflight",
    "db:story-share-preflight": "tsx scripts/verify-story-share-attribution-migration.ts",
    "db:email-campaign-preflight": "tsx scripts/verify-email-campaign-attribution-migration.ts",
    "db:email-campaign-postflight": "tsx scripts/verify-email-campaign-attribution-migration.ts --postflight",
    "seo:audit-public-stories": "tsx scripts/audit-public-story-seo.ts",
    "deploy:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "deploy:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Fast",
    "docs:serve": "npx serve docs/",
    "homepage:assets": "tsx scripts/check-homepage-assets.ts",
    "sample-book:validate": "node scripts/validate-sample-book-output.mjs",
    "sample-book:generate-audio": "tsx scripts/generate-sample-book-audio.ts",
    "landing-assets:sync:children": "tsx scripts/sync-personalized-children-landing-assets.ts",
    "landing-assets:generate-audio": "tsx scripts/generate-localized-landing-audio.ts",
    "landing-assets:validate": "tsx scripts/validate-localized-landing-assets.ts",
    "landing-assets:validate:children": "tsx scripts/validate-personalized-children-assets.ts",
    "i18n:parity": "tsx scripts/check-locale-parity.ts",
    "i18n:keys": "tsx scripts/generate-translation-keys.ts",
    "test": "cross-env NODE_OPTIONS=--no-deprecation jest --detectOpenHandles",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "bash scripts/playwright-fixture/run.sh",
    "test:e2e:mcp": "cross-env SKIP_AUTH_SETUP=1 playwright test tests/playwright/mcp.spec.ts tests/playwright/mcp.contract.spec.ts",
    "test:e2e:mcp:contract": "cross-env SKIP_AUTH_SETUP=1 playwright test tests/playwright/mcp.contract.spec.ts",
    "test:e2e:mcp:auth": "cross-env SKIP_AUTH_SETUP=1 playwright test tests/playwright/mcp.authenticated.spec.ts --workers=1",
    "test:e2e:anon": "cross-env SKIP_AUTH_SETUP=1 playwright test tests/playwright/missing-translations_anonymous.spec.ts --workers=1",
    "test:seo": "tsx scripts/seo-smoke.ts --base-url=http://localhost:3000",
    "test:seo:prod": "tsx scripts/seo-smoke.ts --base-url=https://mythoria.pt",
    "seo:indexnow": "tsx scripts/submit-indexnow.ts",
    "seo:crawlers": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seo-crawler-report.ps1",
    "test:mcp:smoke": "tsx scripts/mcp-e2e-smoke.ts --base-url=http://192.168.1.10:3000",
    "test:mcp:smoke:prod": "tsx scripts/mcp-e2e-smoke.ts --base-url=https://mythoria.pt",
    "auth:mcp:token": "tsx scripts/get-mcp-oauth-token.ts",
    "check:env": "tsx ./scripts/check-env-parity.ts",
    "biographer:cleanup-orphans": "tsx scripts/biographer-orphan-cleanup.ts",
    "story-whisperer:rehearse": "node --import tsx scripts/rehearse-story-whisperer.cjs",
    "story-whisperer:local": "node scripts/biographer-local.mjs",
    "biographer:local": "node scripts/biographer-local.mjs"
  },
  "sideEffects": false,
  "dependencies": {
    "@clerk/backend": "^3.32.0",
    "@clerk/localizations": "^4.26.3",
    "@clerk/nextjs": "^7.10.8",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@google-cloud/pubsub": "^6.4.1",
    "@google-cloud/storage": "^9.0.0",
    "@lexical/history": "^0.53.0",
    "@lexical/html": "^0.53.0",
    "@lexical/react": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/typography": "^0.5.20",
    "daisyui": "^5.8.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.4",
    "image-size": "^2.1.0",
    "lexical": "^0.53.0",
    "libphonenumber-js": "^1.13.17",
    "lucide-react": "^1.79.0",
    "mammoth": "^1.13.0",
    "mermaid": "^12.3.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "next-intl": "^4.16.1",
    "next-mdx-remote": "^6.0.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
    "react-icons": "^5.7.0",
    "react-type-animation": "^3.2.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "stripe": "^23.2.0",
    "svix": "^2.11.1",
    "tsx": "^4.23.15",
    "unified": "^11.0.5",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clerk/testing": "2.3.7",
    "@lingual/i18n-check": "^0.9.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "baseline-browser-mapping": "^2.11.39",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "js-yaml": "^5.5.0",
    "knip": "^6.48.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "tailwindcss": "^4.3.5",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "typescript": "^6.0.3",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": "24.18.1"
  },
  "overrides": {
    "rimraf": "$rimraf",
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "glob": {
      ".": "^14.0.6",
      "minimatch": "^11.0.9"
    },
    "@rollup/plugin-terser": {
      "serialize-javascript": "^7.1.4"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.6"
    },
    "test-exclude": {
      "minimatch": "^11.0.9"
    },
    "@ducanh2912/next-pwa": {
      "workbox-build": "7.4.1",
      "workbox-core": "7.4.1",
      "workbox-webpack-plugin": "7.4.1",
      "workbox-window": "7.4.1"
    },
    "drizzle-kit": {
      "esbuild": "^0.25.12"
    },
    "tsx": {
      "esbuild": "~0.28.2"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "esbuild": false,
    "fsevents": false,
    "protobufjs": false
  }
}
